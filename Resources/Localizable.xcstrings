    "legal.terms.draft": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft terms for the Glint prototype. Use Glint respectfully, do not post unlawful or harmful content, and respect other people’s privacy and intellectual property. This draft must be replaced with legally reviewed Terms of Use before public release."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسودة شروط لنموذج Glint التجريبي. استخدم التطبيق باحترام، ولا تنشر محتوى مخالفاً أو ضاراً، واحترم خصوصية الآخرين وحقوقهم. يجب استبدال هذه المسودة بشروط استخدام مراجعة قانونياً قبل الإطلاق العام."
          }
        }
      }
    },
    "legal.privacy.draft": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft privacy notice for the Glint prototype. A production policy must explain what account, profile, content, device, and usage data are collected, how they are used and shared, how long they are retained, and how users can access or delete them. Replace this draft with a legally reviewed Privacy Policy before public release."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسودة إشعار خصوصية لنموذج Glint التجريبي. يجب أن توضح السياسة الفعلية بيانات الحساب والملف والمحتوى والجهاز والاستخدام التي تُجمع، وكيفية استعمالها ومشاركتها ومدة الاحتفاظ بها، وكيفية الوصول إليها أو حذفها. استبدل هذه المسودة بسياسة خصوصية مراجعة قانونياً قبل الإطلاق العام."
          }
        }
      }
    },
